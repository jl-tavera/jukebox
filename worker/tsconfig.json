{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/vitest-plugin/types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "*.ts", "worker-configuration.d.ts"],
  "exclude": [
    "node_modules",
    // A Bun script run by hand against the live Spotify API, not Workers code.
    // It is checked by the runtime that actually runs it, not by this config.
    "src/sources/spotify/__fixtures__/capture.ts"
  ]
}
