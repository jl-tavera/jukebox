{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jukebox-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-29",

  // The top level is the surface `wrangler dev` runs; vitest reads the `test`
  // environment below. Staging and production share no resource name with this
  // block, so a bare `wrangler deploy` cannot reach either of them -- it
  // deploys this block, onto resources of its own.
  //
  // A binding declared without an id is provisioned by `wrangler deploy`. The
  // id write-back ADR-0002 counted on does not happen for a named environment:
  // wrangler 4.127.1 created all three staging resources and left this file
  // untouched. So the staging ids below were read back with `wrangler d1 list`
  // and `wrangler kv namespace list` and pasted in by hand, and the same is
  // owed to any later deploy that provisions. This file is the infrastructure
  // record only if that happens -- and the KV namespace has no name here at
  // all, so its id is the only record of which namespace this is.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jukebox",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "RESOLUTION_QUEUE",
        "queue": "jukebox-resolution"
      }
    ],

    // One Playlist per delivery. The consumer walks a batch and acknowledges
    // nothing message by message, so a throw sends the whole batch round again
    // -- and a batch of several would re-resolve Playlists that had already
    // succeeded, moving their Version with nothing having changed.
    //
    // What still fails after three attempts lands in the dead-letter queue,
    // which deliberately has no consumer: a Resolution nobody can complete
    // should sit somewhere it can be read rather than disappear.
    "consumers": [
      {
        "queue": "jukebox-resolution",
        "max_batch_size": 1,
        "max_retries": 3,
        "dead_letter_queue": "jukebox-resolution-dlq"
      }
    ]
  },

  // Reading a playlist from Spotify needs a client id and secret, which is the
  // whole reason Resolution is the worker's job rather than the CLI's: a
  // credential in a distributed binary is a credential anyone can read out of
  // it.
  //
  // Naming them here rather than leaving them to be inferred is what makes
  // `wrangler types` deterministic. With this list, generation reads it and
  // stops; without it, wrangler falls back to whatever `.dev.vars` happens to
  // hold -- which is gitignored, so the file a developer generates and the file
  // CI generates would differ, and `types --check` would fail on a commit that
  // is correct.
  //
  // The values never appear here. `wrangler secret put` delivers them to a
  // deployed worker; `.dev.vars` holds them for `wrangler dev`.
  "secrets": {
    "required": ["SPOTIFY_CLIENT_ID", "SPOTIFY_CLIENT_SECRET"]
  },

  // Bindings are non-inheritable, so each environment declares every one of
  // them. That is what keeps staging and production from drifting apart: the
  // config format, rather than a tool watching for it (ADR-0002).
  "env": {
    // The surface vitest runs against, and the one thing it must not share with
    // the others: a live consumer. `POST /playlists` really enqueues during a
    // test, so a subscribed worker would resolve a Playlist no test asked it to
    // resolve, on its own schedule and into whichever test's isolated storage
    // happened to be current. The tests drive the consumer through the worker's
    // own entry point instead -- see test/api.ts.
    //
    // Never deployed. Nothing here names a staging or production resource, so
    // deploying it by accident could reach neither. The queue name it shares
    // with the top level is the local one both already run against.
    "test": {
      "name": "jukebox-api-test",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "jukebox-test",
          "migrations_dir": "migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "CACHE"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "RESOLUTION_QUEUE",
            "queue": "jukebox-resolution"
          }
        ]
      },

      // Empty, and deliberately present rather than omitted. No test reaches
      // Spotify, so this surface holds no credential -- the tests that drive a
      // Resolution hand the consumer one of their own, the same way they stand
      // in for global `fetch`. Saying so keeps `wrangler types` off the
      // `.dev.vars` fallback here too, and stops wrangler warning on every run
      // about a secret this environment is not supposed to have.
      "secrets": {
        "required": []
      }
    },

    "staging": {
      "name": "jukebox-api-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "jukebox-staging",
          "database_id": "40c7cec6-3bdc-4579-9276-3612c9be4d2d",
          "migrations_dir": "migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "CACHE",
          // Titled jukebox-api-staging-cache by the provisioning deploy, from
          // the Worker name and the binding. Nothing here chose that name.
          "id": "d396e35710a047d79b068493fa189f2c"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "RESOLUTION_QUEUE",
            "queue": "jukebox-resolution-staging"
          }
        ],
        "consumers": [
          {
            "queue": "jukebox-resolution-staging",
            "max_batch_size": 1,
            "max_retries": 3,
            "dead_letter_queue": "jukebox-resolution-staging-dlq"
          }
        ]
      },
      "secrets": {
        "required": ["SPOTIFY_CLIENT_ID", "SPOTIFY_CLIENT_SECRET"]
      }
    },

    "production": {
      "name": "jukebox-api-production",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "jukebox-production",
          "migrations_dir": "migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "CACHE"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "RESOLUTION_QUEUE",
            "queue": "jukebox-resolution-production"
          }
        ],
        "consumers": [
          {
            "queue": "jukebox-resolution-production",
            "max_batch_size": 1,
            "max_retries": 3,
            "dead_letter_queue": "jukebox-resolution-production-dlq"
          }
        ]
      },
      "secrets": {
        "required": ["SPOTIFY_CLIENT_ID", "SPOTIFY_CLIENT_SECRET"]
      }
    }
  }
}
