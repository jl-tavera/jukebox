# Claude Code local config, skills and session state
.claude/

# Agent instructions - kept local, not published
/CLAUDE.md
/docs/agents/

# Dependencies and build output
node_modules/
.next/
dist/
out/
next-env.d.ts
*.tsbuildinfo

# Wrangler's local state: the Miniflare-backed D1, KV and queue that tests and
# `wrangler dev` run against. Rebuilt on demand; never the infra record.
.wrangler/

# What a Playwright run leaves behind: traces and screenshots for whatever
# failed, the HTML report, and the browsers themselves. All of it is output
# about one run on one machine. The fixture the harness serves is not here --
# `site/e2e/fixtures/` is committed, because a test that has to build a font
# before it can run is a test nobody runs.
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Regenerated by `next dev` on every run; agent docs stay local
AGENTS.md
site/CLAUDE.md

# Secrets - never commit. Wrangler reads .dev.vars for local `wrangler dev`.
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
